<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlueHeighliner.NugetFetcher.ViewModels"
        xmlns:models="using:BlueHeighliner.NugetFetcher.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        x:Class="BlueHeighliner.NugetFetcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/src/Assets/avalonia-logo.ico"
        Title="NugetFetcher"
        Width="700" Height="600">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,150,Auto,Auto,*" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Dotnet Runtime Version:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding DotnetRuntimeVersion}" PlaceholderText="e.g. 10.0.5" />
            <Button Grid.Column="2" Content="Browse" Margin="12,0,0,0" Click="OnBrowseClick" IsEnabled="{Binding !IsBusy}" />
            <Button Grid.Column="3" Content="Clear" Margin="8,0,0,0" Click="OnClearClick" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="150,1,*" Background="#22808080" Margin="4">
                    <TextBlock Grid.Column="0" Text="Version" FontWeight="Bold" TextAlignment="Right" Margin="0,0,8,0" />
                    <Border Grid.Column="1" Background="Gray" />
                    <TextBlock Grid.Column="2" Text="Package Id" FontWeight="Bold" Margin="8,0,0,0" />
                </Grid>
                <ListBox ItemsSource="{Binding Packages}" IsEnabled="{Binding !IsBusy}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PackageRequest">
                            <Grid ColumnDefinitions="150,1,*">
                                <TextBlock Grid.Column="0" Text="{Binding Version}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0" />
                                <Border Grid.Column="1" Background="Gray" />
                                <TextBlock Grid.Column="2" Text="{Binding Id}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="{Binding CurrentTask}" IsVisible="{Binding IsBusy}" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Row="3" Margin="0,4,0,0" IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Button Grid.Row="4" Margin="0,12,0,0" Content="Download..." HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Click="OnDownloadClick" IsEnabled="{Binding CanDownload}" />
    </Grid>

</Window>
