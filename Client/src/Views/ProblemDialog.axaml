<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="200"
        x:Class="NugetFetcher.Views.ProblemDialog"
        Icon="/src/Assets/avalonia-logo.ico"
        Title="Problem"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="16">
        <ScrollViewer MaxHeight="300">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        </ScrollViewer>
        <Button Content="OK" HorizontalAlignment="Right" Click="OnOkClick" IsDefault="True" />
    </StackPanel>

</Window>
